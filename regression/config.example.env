# Copy to a file outside the repo and fill in. Values with <...> must be set; the rest are working defaults.

# Each run creates the project <PROJECT_PREFIX>-<timestamp> and deletes it at the end (KEEP=1 leaves it).
PROJECT_PREFIX=<project-name-prefix>
KEEP=0

# The two versions to compare: an image the cluster can pull (IMAGE_*), or a git ref of this repo that is built
# in the project from MergerCli/Dockerfile (REF_*). IMAGE_* wins when both are set.
LABEL_A=base
IMAGE_A=
REF_A=<git-ref, e.g. a release tag>
LABEL_B=head
IMAGE_B=
REF_B=<git-ref, e.g. origin/master>

# Input GPKGs: s3://<bucket>/<prefix> (copied inside the cluster) or a local folder (streamed with oc exec).
SAMPLE=<s3://bucket/prefix or /path/to/folder>
# Only for an s3:// sample. Export the keys in your shell instead of writing them here.
SAMPLE_S3_ENDPOINT=<https://s3-host:port>
SAMPLE_S3_ACCESS_KEY_ID=${SAMPLE_S3_ACCESS_KEY_ID:-}
SAMPLE_S3_SECRET_ACCESS_KEY=${SAMPLE_S3_SECRET_ACCESS_KEY:-}

# See cases.example.tsv. With more than one thread count, each is also compared against the first, which catches
# output that depends on thread timing.
CASES=<path/to/cases.tsv>
THREADS="1 4"
BATCH=1000
# Extra CLI settings as KEY=VALUE pairs (.NET config keys, sections joined by __). Values cannot contain spaces.
CLI_ENV="S3__request__timeoutSec=60"

# Empty uses the cluster's default storage class: check what it costs first, it is often a premium disk.
STORAGE_CLASS=
DATA_SIZE=20Gi
MINIO_SIZE=20Gi
RUNNER_CPU=2
RUNNER_MEMORY=4Gi
TIMEOUT_MINUTES=600
# A dockerconfigjson file, when the images below need registry credentials.
PULL_SECRET_FILE=

MINIO_IMAGE=docker.io/bitnamilegacy/minio@sha256:8935e75fa5d11295c17171e4aa49efe390a1193cd7f12e4d21b92af9ffef09d7
MINIO_CMD="/opt/bitnami/minio/bin/minio server /data"
AWS_CLI_IMAGE=docker.io/amazon/aws-cli:2.22.35
COMPARE_IMAGE=docker.io/library/python:3.12.7-slim
COMPARE_PACKAGES="numpy==2.1.3 pillow==11.0.0 boto3==1.35.68"
# A PyPI mirror, when the cluster cannot reach pypi.org.
PIP_INDEX_URL=

RESULTS_DIR=
